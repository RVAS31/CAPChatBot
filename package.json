{
  "name": "chatboxcloudv2",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.14.3",
    "@langchain/core": "^0.3.72",
    "@langchain/langgraph": "^0.4.7",
    "@langchain/openai": "^0.5.18",
    "@sap-ai-sdk/langchain": "^1.18.0",
    "@sap-ai-sdk/orchestration": "^1.18.0",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/resilience": "^4.0.2",
    "@sap/cds": "^8",
    "@sap/cds-dk": "^8.9.2",
    "@sap/hana-client": "^2.24.24",
    "@sap/ux-specification": "^1.124.14",
    "@sap/xssec": "^4.6.0",
    "csv-parser": "^3.2.0",
    "express": "^4",
    "jszip": "^3.10.1",
    "langchain": "^0.3.31",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "rimraf": "^6.0.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "debug": "cds run --with-mocks --in-memory"
  },
  "cds": {
    "i18n": {
      "languages": [
        "en_EN",
        "de"
      ],
      "folder": "i18n",
      "file": "i18n"
    },
    "requires": {
      "uaa": {
        "kind": "xsuaa"
      },
      "db": {
        "kind": "sqlite",
        "model": [
          "db",
          "srv"
        ],
        "[development]": {
          "kind": "sqlite",
          "model": [
            "db",
            "srv"
          ]
        },
        "[production]": {
          "kind": "hana-cloud",
          "model": [
            "db/data-config",
            "db/data"
          ]
        }
      }
    }
  },
  "sapux": [
    "app"
  ]
}
