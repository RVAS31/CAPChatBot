<mvc:View
    controllerName="app.controller.Chatbox"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="chatPage"
        title="Sales Quote Assistant"
        enableScrolling="false"
    >
        <content>
            <VBox
                id="_IDGenVBox"
                width="100%"
                height="100%"
                fitContainer="true"
            >
                <ScrollContainer
                    id="chatScrollContainer"
                    width="100%"
                    height="100%"
                    vertical="true"
                    horizontal="false"
                    focusable="false"
                >
                    <List
                        id="chatList"
                        items="{chatBotModel>/messages}"
                        showSeparators="None"
                        busyIndicatorDelay="0"
                        updateFinished=".onChatListUpdateFinished"
                        growing="true"
                        growingScrollToLoad="true"
                        growingThreshold="30"
                        width="100%"
                    >
                        <CustomListItem id="_IDGenCustomListItem">
                            <HBox
                                id="_IDGenHBox3"
                                width="100%"
                                justifyContent="{= ${chatBotModel>sender} === 'user' ? 'End' : 'Start' }"
                            >
                                <VBox
                                    id="_IDGenVBox2"
                                    class="sapUiSmallMargin userBubble"
                                >
                                    <core:Icon
                                        id="_IDGenIcon"
                                        src="{= ${chatBotModel>sender} === 'user' ? 'sap-icon://person-placeholder' : 'sap-icon://ai' }"
                                        size="1rem"
                                        class="sapUiTinyMargin"
                                    />

                                    <FormattedText
                                        id="_IDGenFormattedText1"
                                        htmlText="{chatBotModel>htmlMessage}"
                                        class="sapUiTinyMargin"
                                    />

                                    <Text
                                        id="_IDGenText2"
                                        text="{
                                            path: 'chatBotModel>timestamp',
                                            formatter: '.formatter.formatCreatedAt'
                                        }"
                                        class="sapUiTinyMarginTop sapUiTinyMarginEnd"
                                    />

                                    <Button
                                        id="_IDGenButton"
                                        icon="sap-icon://manager-insight"
                                        press=".onDownloadReport"
                                        visible="{= !${chatBotModel>shouldNotReported}}"
                                        class="sapUiTinyMarginTop sapUiTinyMarginEnd"
                                    >
                                        <customData>
                                            <core:CustomData
                                                key="reportId"
                                                value="{chatBotModel>id}"
                                            />
                                        </customData>
                                    </Button>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>
                </ScrollContainer>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar
                id="_IDGenOverflowToolbar"
                width="100%"
            >
                <Input
                    id="messageInput"
                    placeholder="Type your message..."
                    liveChange=".onLiveChange"
                    valueLiveUpdate="true"
                    value="{chatBotModel>/currentPrompt}"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData
                            id="_IDGenOverflowToolbarLayoutData1"
                            shrinkable="true"
                            priority="NeverOverflow"
                        />
                    </layoutData>
                </Input>

                <Button
                    id="sendButton"
                    icon="sap-icon://paper-plane"
                    press=".onAskAI"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData
                            id="_IDGenOverflowToolbarLayoutData2"
                            priority="NeverOverflow"
                        />
                    </layoutData>
                </Button>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
